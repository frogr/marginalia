{
  "name": "marginalia",
  "version": "0.1.0",
  "description": "Ask questions about twelve public-domain novels. Answers cite passages, and every quote is checked against the source text.",
  "license": "MIT",
  "author": "Austin French (https://austn.net)",
  "repository": {
    "type": "git",
    "url": "https://github.com/frogr/marginalia"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "corpus": "tsx scripts/build-corpus.ts",
    "embed": "tsx scripts/embed.ts",
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server/index.js",
    "eval": "tsx src/eval/run.ts",
    "eval:explain": "tsx src/eval/explain.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "stemmer": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
