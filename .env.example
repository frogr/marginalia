# Everything is optional. With no keys, Marginalia uses BM25 retrieval and extractive answers.

# Cited answers from Claude (preferred when both keys are set).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Cited answers from OpenAI when there is no Anthropic key, and hybrid retrieval
# when `npm run embed` has built data/embeddings/ (needs this key at build and run time).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# Model calls allowed per UTC day across all visitors. After that, answers are extractive.
DAILY_LLM_LIMIT=200
# /api/ask requests per IP per minute.
ASK_PER_MINUTE=12
# Model request timeout in milliseconds.
LLM_TIMEOUT_MS=25000
# Set to 1 behind a trusted proxy (Render sets RENDER=true, which also enables this).
TRUST_PROXY=
PORT=3000
